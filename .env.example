# Copy to .env (or set in your host's dashboard). All optional except the API key for the coach.

# Enables the AI coach (Claude). Without it, everything else still works.
ANTHROPIC_API_KEY=
# Model used by the coach. Defaults to claude-opus-5-5.
# COACH_MODEL=claude-opus-5-5

# Where the SQLite database lives. Point this at a persistent volume in production.
# DATABASE_PATH=./data/lighthouse.db
# PORT=3001

# Account sign-up. With ALLOW_SIGNUP=false only the very first account can be created
# (handy while the app is just for you). Or require an invite code for new accounts.
# ALLOW_SIGNUP=false
# SIGNUP_INVITE_CODE=
